# Variables d'environnement de Rampe.
#
# Rien n'est à faire pour un premier lancement : `docker compose up` fonctionne
# sans fichier .env. Pour changer une valeur, copier ce fichier vers .env, que
# docker compose lit automatiquement. Le fichier .env n'est jamais versionné.

# --- Identifiants locaux -----------------------------------------------------
# Valeurs publiques, réservées au poste de développement. La mention "local-only"
# est volontaire : l'API et le worker refusent de démarrer avec un identifiant
# qui la contient quand NODE_ENV=production.
POSTGRES_PASSWORD=rampe-local-only
VALKEY_PASSWORD=rampe-local-only
# Chemin secret du navigateur de scan ; commence par une barre oblique.
BROWSER_WS_PATH=/rampe-browser-local-only

# --- Variables lues par les services -----------------------------------------
# docker-compose.yml les renseigne lui-même à partir des identifiants ci-dessus.
# Elles sont listées ici pour un déploiement ou un lancement hors de Docker.
#
# API et worker :
#   NODE_ENV       development | test | production
#   VALKEY_URL     redis://:<mot de passe>@<hôte>:6379   (Valkey parle le protocole Redis)
# Worker, pour scanner :
#   BROWSER_WS_ENDPOINT  ws://browser:3000<chemin secret>
#   EGRESS_PROXY_URL     http://egress-proxy:3128
#   SCAN_BOT_INFO_URL    page qui présente le robot, citée dans son User-Agent
# Navigateur (conteneur browser) :
#   BROWSER_WS_PATH      chemin secret de son point d'accès, 24 caractères au moins
#   EGRESS_PROXY_URL     http://egress-proxy:3128
# Proxy de sortie (conteneur egress-proxy) :
#   PORT                           3128 par défaut
#   EGRESS_ALLOWED_PRIVATE_HOSTS   hôtes autorisés à résoudre vers une adresse privée,
#                                  séparés par des virgules. Développement seulement :
#                                  doit rester vide en production.
# API seulement :
#   PORT           port d'écoute, 3000 par défaut
#   DATABASE_URL   postgresql://<utilisateur>:<mot de passe>@<hôte>:5432/<base>
# Site de test seulement :
#   PORT           port d'écoute, 8080 par défaut
# Tests de bout en bout seulement :
#   BASE_URL       adresse de l'application, http://127.0.0.1:8080 par défaut
