{
  "name": "rampe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter \"!@rampe/e2e\" run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "pnpm --filter @rampe/e2e run test",
    "licenses:check": "pnpm -r licenses list --json | node scripts/check-licenses.mjs",
    "audit:deps": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@types/node": "26.6.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
