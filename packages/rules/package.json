{
  "name": "@rampe/rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "generate": "node scripts/generate-data.ts && prettier --write src/rgaa/data && pnpm run report",
    "report": "tsc -p tsconfig.build.json && node scripts/generate-report.ts && prettier --write ../../docs/rgaa-4.1.2.md"
  },
  "devDependencies": {
    "axe-core": "4.13.0"
  }
}
