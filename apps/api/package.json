{
  "name": "@rampe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "prisma generate >/dev/null && NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "prisma generate >/dev/null && NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js",
    "prisma:generate": "prisma generate",
    "migrate:create": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rampe/rules": "workspace:*",
    "@rampe/shared": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.14",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1"
  }
}
