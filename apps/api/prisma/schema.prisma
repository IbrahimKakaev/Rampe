// Data model of Rampe. Every table that belongs to an organisation carries
// organization_id, so that every query can, and must, filter on it.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-case.
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  sessions     Session[]
  tokens       AuthToken[]
  memberships  Membership[]
  audits       Audit[]
  auditResults AuditResult[]

  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its hash is stored.
model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use tokens sent by e-mail. Only their hash is stored.
model AuthToken {
  tokenHash String        @id @map("token_hash")
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Organization {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  /// Scans older than this are deleted.
  retentionMonths Int      @default(12) @map("retention_months")
  createdAt       DateTime @default(now()) @map("created_at")

  memberships Membership[]
  invitations Invitation[]
  sites       Site[]
  scans         Scan[]
  pages         ScanPage[]
  findings      Finding[]
  notifications Notification[]
  audits        Audit[]
  auditPages    AuditPage[]
  auditResults  AuditResult[]
  statements    Statement[]

  @@map("organizations")
}

enum Role {
  OWNER
  MEMBER
}

model Membership {
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Stored lower-case.
  email          String
  role           Role
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

enum VerificationMethod {
  DNS
  FILE
}

enum ScanSchedule {
  NONE
  DAILY
  WEEKLY
}

model Site {
  id                 String              @id @default(uuid(7)) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  /// Origin of the site, such as https://www.example.fr
  origin             String
  host               String
  /// Public token the owner publishes to prove ownership.
  verificationToken  String              @map("verification_token")
  verificationMethod VerificationMethod? @map("verification_method")
  verifiedAt         DateTime?           @map("verified_at")
  maxPages           Int                 @default(25) @map("max_pages")
  schedule           ScanSchedule        @default(NONE)
  /// When the next scheduled scan is due; null when the site has no schedule.
  nextScanAt         DateTime?           @map("next_scan_at")
  createdAt          DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scans        Scan[]
  audits       Audit[]

  @@unique([organizationId, origin])
  @@index([organizationId])
  @@index([nextScanAt])
  @@map("sites")
}

enum ScanTrigger {
  MANUAL
  SCHEDULED
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

model Scan {
  id                  String      @id @default(uuid(7)) @db.Uuid
  organizationId      String      @map("organization_id") @db.Uuid
  siteId              String      @map("site_id") @db.Uuid
  trigger             ScanTrigger
  status              ScanStatus  @default(QUEUED)
  /// Why a scan failed or stopped early, as the scan engine reports it.
  reason              String?
  createdAt           DateTime    @default(now()) @map("created_at")
  startedAt           DateTime?   @map("started_at")
  finishedAt          DateTime?   @map("finished_at")
  axeVersion          String?     @map("axe_version")
  referentialVersion  String      @map("referential_version")
  pageCount           Int?        @map("page_count")
  checksPassed        Int?        @map("checks_passed")
  checksFailed        Int?        @map("checks_failed")
  checksIncomplete    Int?        @map("checks_incomplete")
  /// Automated pre-audit score, between 0 and 1. Never an RGAA conformity rate.
  score               Float?
  findingsAdded       Int?        @map("findings_added")
  findingsFixed       Int?        @map("findings_fixed")
  skippedByRobots     Int?        @map("skipped_by_robots")
  skippedBeyondLimits Int?        @map("skipped_beyond_limits")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages         ScanPage[]
  findings      Finding[]
  notifications Notification[]
  audits        Audit[]

  @@index([organizationId, createdAt])
  @@index([siteId, createdAt])
  @@map("scans")
}

enum PageStatus {
  ANALYZED
  FAILED
}

model ScanPage {
  id              String     @id @default(uuid(7)) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  scanId          String     @map("scan_id") @db.Uuid
  /// Order in which the scan visited the page.
  position        Int
  url             String
  path            String
  depth           Int
  status          PageStatus
  error           String?
  httpStatus      Int?       @map("http_status")
  title           String?
  passedRules     String[]   @map("passed_rules")
  incompleteRules String[]   @map("incomplete_rules")
  truncated       Boolean    @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan         Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findings     Finding[]

  @@unique([scanId, position])
  @@index([organizationId])
  @@map("scan_pages")
}

model Finding {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scanId         String   @map("scan_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  ruleId         String   @map("rule_id")
  impact         String?
  selector       String
  /// HTML extract, 500 characters at most.
  html           String
  wcag           String[]
  /// RGAA criteria the rule is linked to with certainty.
  rgaaCriteria   String[] @map("rgaa_criteria")
  /// Criteria linked with doubt: shown as "to confirm", never as a fact.
  rgaaUncertain  String[] @map("rgaa_uncertain")
  fingerprint    String
  /// True when the previous scan of the site did not have this defect.
  isNew          Boolean  @default(false) @map("is_new")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan         Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  page         ScanPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([scanId, ruleId])
  @@index([pageId])
  @@map("findings")
}

enum NotificationType {
  /// New defects since the previous scan.
  REGRESSION
}

/// An alert sent about a scan. Unique per scan and type: an alert is never sent twice.
model Notification {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  scanId         String           @map("scan_id") @db.Uuid
  type           NotificationType
  /// How many members it was sent to.
  recipients     Int
  sentAt         DateTime         @default(now()) @map("sent_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan         Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, type])
  @@index([organizationId])
  @@map("notifications")
}

/// Status of a criterion on a page of an audit sample.
enum AuditStatus {
  /// Conforme
  C
  /// Non conforme
  NC
  /// Non applicable
  NA
}

/// Who set a status: the automated results (a defect found) or the auditor.
enum AuditOrigin {
  AUTOMATIC
  AUDITOR
}

/// What the automated results propose for a criterion (PLAN.md, §4.2).
enum ProposalKind {
  NON_COMPLIANT
  COMPLIANT_TO_CONFIRM
  CLUE
}

/// A manual audit of a site, on a sample of pages, against the 106 RGAA criteria.
model Audit {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  siteId             String   @map("site_id") @db.Uuid
  /// The scan whose results feed the proposals; kept as null once purged.
  scanId             String?  @map("scan_id") @db.Uuid
  referentialVersion String   @map("referential_version")
  createdById        String?  @map("created_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  scan         Scan?        @relation(fields: [scanId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  pages        AuditPage[]
  statement    Statement?

  @@index([organizationId])
  @@index([siteId, createdAt])
  @@map("audits")
}

/// A page of the sample of an audit.
model AuditPage {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  auditId        String  @map("audit_id") @db.Uuid
  position       Int
  url            String
  /// What the page is, such as "Accueil" or "Contact".
  title          String
  /// The page of the reference scan with the same address, when there is one.
  scanPageId     String? @map("scan_page_id") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  results      AuditResult[]

  @@unique([auditId, url])
  @@index([organizationId])
  @@map("audit_pages")
}

/// The status of a criterion on a page of the sample, and what the automated results propose.
model AuditResult {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  auditPageId    String        @map("audit_page_id") @db.Uuid
  criterion      String
  /// null while the criterion is not evaluated on the page.
  status         AuditStatus?
  origin         AuditOrigin?
  note           String?
  proposal       ProposalKind?
  /// The axe-core rules behind the proposal.
  proposalRules  String[]      @map("proposal_rules")
  authorId       String?       @map("author_id") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         AuditPage    @relation(fields: [auditPageId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([auditPageId, criterion])
  @@index([organizationId])
  @@map("audit_results")
}

/// What the accessibility statement of an audit says beyond the audit results.
model Statement {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  auditId          String   @unique @map("audit_id") @db.Uuid
  entityName       String   @default("") @map("entity_name")
  serviceName      String   @default("") @map("service_name")
  auditedBy        String   @default("") @map("audited_by")
  derogations      String   @default("")
  exemptions       String   @default("")
  technologies     String   @default("")
  testEnvironment  String   @default("") @map("test_environment")
  tools            String   @default("")
  contactFormUrl   String   @default("") @map("contact_form_url")
  contactDetails   String   @default("") @map("contact_details")
  multiYearPlanUrl String   @default("") @map("multi_year_plan_url")
  actionPlanUrl    String   @default("") @map("action_plan_url")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("statements")
}
