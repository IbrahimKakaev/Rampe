# Configuration de production de Rampe. Copier vers .env.prod, sur le serveur
# seulement, et remplacer chaque valeur. Ce fichier n'est jamais versionné.
# Voir docs/DEPLOIEMENT.md.

# Adresse publique de l'application, sans https:// ni barre finale.
RAMPE_DOMAIN=rampe-demo.duckdns.org
# Adresse pour Let's Encrypt : avertissements sur le certificat.
ACME_EMAIL=vous@exemple.fr

# Secrets : générer chacun avec `openssl rand -base64 32 | tr -d '/+='`.
POSTGRES_PASSWORD=a-generer
VALKEY_PASSWORD=a-generer
# Chemin secret du navigateur de scan : une barre oblique, puis 24 caractères au moins.
BROWSER_WS_PATH=/a-generer

# Envoi des e-mails. Brevo : smtp://<identifiant SMTP>:<clé SMTP>@smtp-relay.brevo.com:587
# Les caractères spéciaux de l'identifiant et de la clé s'encodent (@ devient %40).
SMTP_URL=smtp://identifiant%40exemple.fr:cle@smtp-relay.brevo.com:587
# Expéditeur, dont l'adresse est vérifiée chez le service d'envoi.
MAIL_FROM=Rampe <vous@exemple.fr>
